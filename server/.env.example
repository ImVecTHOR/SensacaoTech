# Porta em que a API vai escutar
PORT=3001

# Origens permitidas para CORS, separadas por vírgula.
# Use "*" apenas em desenvolvimento. Em produção, coloque o(s) domínio(s)
# reais do site, ex: https://sensacaotech.com,https://www.sensacaotech.com
ALLOWED_ORIGINS=*

# Tamanho máximo de arquivo aceito (em MB)
MAX_FILE_MB=100

# Quantas horas um arquivo fica disponível antes de expirar automaticamente
EXPIRY_HOURS=24

# Pasta onde os metadados e os arquivos cifrados ficam salvos
# (por padrão usa ./data dentro da pasta server/)
DATA_DIR=./data
